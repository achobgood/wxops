{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wxcli update --hook",
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(wxcli:*)",
      "Bash(which:*)"
    ]
  }
}
