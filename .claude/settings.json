{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(wxcli:*)",
      "Bash(which:*)",
      "Bash(pip install -e:*)",
      "Bash(pip3 install -e:*)",
      "Bash(pip3.11:*)",
      "Bash(python3.11:*)",
      "Bash(PYTHONPATH=.:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/wxcli-gate.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
